**

!.dockerignore
!LICENSE
!package.json
!package-lock.json

!platform
!platform/package.json
!platform/package-lock.json
!platform/docker
platform/docker/**
!platform/docker/media-worker
!platform/docker/media-worker/assemble-runtime.sh
!platform/docker/media-worker/electron-headless.sh
!platform/docker/media-worker/write-production-pins.js
!platform/docker/media-worker/work-root
!platform/docker/media-worker/work-root/.keep
!platform/src
!platform/src/**
platform/src/development
platform/src/development/**

# The pinned clean client tree (package.json + package-lock.json + full src)
# ships inside the production Worker image for delivery validation.
!src
!src/**
!src/shared
!src/shared/**

!scripts
scripts/**
!scripts/verify-upstream-petpack-import.js
