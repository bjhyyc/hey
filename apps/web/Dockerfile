FROM node:22.22.2-alpine3.23@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22.22.2-alpine3.23@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f AS builder
WORKDIR /app
ARG NEXT_PUBLIC_CLOUDBASE_ENV_ID=petpack-staging-d3ffsbun2dc89fae
ARG NEXT_PUBLIC_CLOUDBASE_REGION=ap-shanghai
ARG NEXT_PUBLIC_PETPACK_PHONE_AUTH_ENABLED=true
ARG NEXT_PUBLIC_KAIPAY_WXPAY_ENABLED=false
ARG NEXT_PUBLIC_PETPACK_PLAN_CODE=hey-petpack-standard-48-20260902
ARG NEXT_PUBLIC_PETPACK_PRICE_FEN=7800
ARG NEXT_PUBLIC_PETPACK_LIST_PRICE_FEN=10000
ARG NEXT_PUBLIC_SUPPORT_QQ=3501551445
# Empty until the operator creates a customer-service group / mailbox; the
# support page renders only the channels that are actually configured.
ARG NEXT_PUBLIC_SUPPORT_QQ_GROUP=
ARG NEXT_PUBLIC_SUPPORT_QQ_GROUP_URL=
ARG NEXT_PUBLIC_SUPPORT_QQ_CARD_URL=https://qm.qq.com/q/76leGCLqwM
ARG NEXT_PUBLIC_SUPPORT_EMAIL=
ARG NEXT_PUBLIC_CLIENT_DOWNLOAD_URL=https://hey-download-1462360313.cos.ap-shanghai.myqcloud.com/client/Hey-Setup-1.0.0.exe
ARG NEXT_PUBLIC_CLIENT_DOWNLOAD_SHA256=e19ac9a35aace1e5a9a7d6c124b654cd63fcf334c1513ef36f2562c8d1913f96
ARG NEXT_PUBLIC_CLIENT_VERSION=1.0.0
ARG NEXT_PUBLIC_MACOS_CLIENT_DOWNLOAD_URL=
ENV NEXT_PUBLIC_CLOUDBASE_ENV_ID=$NEXT_PUBLIC_CLOUDBASE_ENV_ID \
    NEXT_PUBLIC_CLOUDBASE_REGION=$NEXT_PUBLIC_CLOUDBASE_REGION \
    NEXT_PUBLIC_PETPACK_PHONE_AUTH_ENABLED=$NEXT_PUBLIC_PETPACK_PHONE_AUTH_ENABLED \
    NEXT_PUBLIC_KAIPAY_WXPAY_ENABLED=$NEXT_PUBLIC_KAIPAY_WXPAY_ENABLED \
    NEXT_PUBLIC_PETPACK_PLAN_CODE=$NEXT_PUBLIC_PETPACK_PLAN_CODE     NEXT_PUBLIC_PETPACK_PRICE_FEN=$NEXT_PUBLIC_PETPACK_PRICE_FEN     NEXT_PUBLIC_PETPACK_LIST_PRICE_FEN=$NEXT_PUBLIC_PETPACK_LIST_PRICE_FEN     NEXT_PUBLIC_SUPPORT_QQ=$NEXT_PUBLIC_SUPPORT_QQ     NEXT_PUBLIC_SUPPORT_QQ_GROUP=$NEXT_PUBLIC_SUPPORT_QQ_GROUP     NEXT_PUBLIC_SUPPORT_QQ_GROUP_URL=$NEXT_PUBLIC_SUPPORT_QQ_GROUP_URL     NEXT_PUBLIC_SUPPORT_QQ_CARD_URL=$NEXT_PUBLIC_SUPPORT_QQ_CARD_URL     NEXT_PUBLIC_SUPPORT_EMAIL=$NEXT_PUBLIC_SUPPORT_EMAIL     NEXT_PUBLIC_CLIENT_DOWNLOAD_URL=$NEXT_PUBLIC_CLIENT_DOWNLOAD_URL     NEXT_PUBLIC_CLIENT_DOWNLOAD_SHA256=$NEXT_PUBLIC_CLIENT_DOWNLOAD_SHA256     NEXT_PUBLIC_CLIENT_VERSION=$NEXT_PUBLIC_CLIENT_VERSION \
    NEXT_PUBLIC_MACOS_CLIENT_DOWNLOAD_URL=$NEXT_PUBLIC_MACOS_CLIENT_DOWNLOAD_URL
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22.22.2-alpine3.23@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f AS runner
ENV NODE_ENV=production
ENV PORT=3000
WORKDIR /app
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
