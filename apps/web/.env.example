# Required in every non-mock environment. When either value is absent, server
# requests fail closed and no paid workflow can start.
PETPACK_STUDIO_API_ORIGIN=
PETPACK_STUDIO_INTERNAL_TOKEN=

# CloudBase browser configuration. Never put a secret key in NEXT_PUBLIC_*.
NEXT_PUBLIC_CLOUDBASE_ENV_ID=petpack-staging-d3ffsbun2dc89fae
NEXT_PUBLIC_CLOUDBASE_REGION=ap-shanghai
# Keep false until CloudBase CAPTCHA, quotas and the server-side exchange gate
# are verified for the production domain.
NEXT_PUBLIC_PETPACK_PHONE_AUTH_ENABLED=false
NEXT_PUBLIC_KAIPAY_WXPAY_ENABLED=false
NEXT_PUBLIC_PETPACK_PLAN_CODE=petpack-seven-action-v1

# Development-only simulated payment. Production must keep this false.
PETPACK_ALLOW_SIMULATED_PAYMENT=false
