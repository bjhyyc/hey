{
	admin off
}

api.heyirmy.com {
	@health path /health
	@ready path /readyz
	@kaipay_notification {
		method POST
		path_regexp kaipay ^/api/payments/kaipay/notify/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$
	}
	@studio path /api/auth/* /api/checkout /api/projects /api/projects/* /api/admin/*

	handle @health {
		respond "ok" 200
	}
	handle @ready {
		reverse_proxy studio-api:8787
	}
	handle @kaipay_notification {
		reverse_proxy studio-api:8787
	}
	handle @studio {
		reverse_proxy studio-api:8787
	}
	handle {
		respond "not found" 404
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	log {
		output stdout
		format json
	}
}

:8080 {
	@health path /health
	handle @health {
		respond "ok" 200
	}
	handle {
		respond "not found" 404
	}
}
