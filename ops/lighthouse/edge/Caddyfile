{
	admin off
}

api.heyirmy.com {
	@health path /health
	@auth path /api/auth/*

	handle @health {
		respond "ok" 200
	}
	handle @auth {
		reverse_proxy auth-api:8787
	}
	handle {
		respond "not found" 404
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	log {
		output stdout
		format json
	}
}

:8080 {
	@health path /health
	handle @health {
		respond "ok" 200
	}
	handle {
		respond "not found" 404
	}
}
